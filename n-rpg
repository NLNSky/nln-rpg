end)

-- Height slider
local function setHeightFromX(x)
    local left = Slider.AbsolutePosition.X
    local width = Slider.AbsoluteSize.X
    local alpha = math.clamp((x - left) / width, 0, 1)

    Settings.Height = math.floor(alpha * 100 + 0.5) / 10
    Fill.Size = UDim2.new(alpha, 0, 1, 0)
    HeightLabel.Text = "Height: " .. string.format("%.1f", Settings.Height)
end

Slider.MouseButton1Down:Connect(function(x)
    setHeightFromX(x)

    local connection
    connection = UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            setHeightFromX(input.Position.X)
        end
    end)

    local ended
    ended = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            connection:Disconnect()
            ended:Disconnect()
        end
    end)
end)

