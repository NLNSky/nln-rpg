-- Auto Perk: Q, E, R, G
local perkKeys = {
    Enum.KeyCode.Q,
    Enum.KeyCode.E,
    Enum.KeyCode.R,
    Enum.KeyCode.G,
}

local function pressKey(keyCode)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    task.wait(0.03)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

task.spawn(function()
    while ScreenGui.Parent do
        if Settings.AutoPerk then
            for _, keyCode in ipairs(perkKeys) do
                if not Settings.AutoPerk then
                    break
                end
                pressKey(keyCode)
                task.wait(0.05)
            end
        else
            task.wait(0.1)
        end
    end
end)

-- NPC detection
local function getNPCs()
    local result = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= Character then
            local npcHumanoid = obj:FindFirstChildOfClass("Humanoid")
            local npcRoot = obj:FindFirstChild("HumanoidRootPart")
                or obj:FindFirstChild("UpperTorso")
                or obj:FindFirstChild("Torso")

            if npcHumanoid and npcRoot and npcHumanoid.Health > 0 then
                local isPlayerCharacter = Players:GetPlayerFromCharacter(obj) ~= nil

                if not isPlayerCharacter then
                    table.insert(result, {
                        Model = obj,
                        Humanoid = npcHumanoid,
                        Root = npcRoot,
                    })
                end
            end
        end
    end

    return result
end

local currentTarget = nil

local function chooseRandomNPC()
    local npcs = getNPCs()

    if #npcs == 0 then
        return nil
    end

    return npcs[math.random(1, #npcs)]
end

local function validTarget(target)
    return target
        and target.Model
        and target.Model.Parent
        and target.Humanoid
        and target.Humanoid.Parent
        and target.Root
        and target.Root.Parent
        and target.Humanoid.Health > 0
end

-- Under Fly
RunService.Heartbeat:Connect(function()
    if not Settings.UnderFly then
        return
    end

    if not Character or not Character.Parent or not RootPart or not RootPart.Parent then
        refreshCharacter()
        return
    end

    if not validTarget(currentTarget) then
        currentTarget = chooseRandomNPC()
    end

    if validTarget(currentTarget) then
        local targetRoot = currentTarget.Root

        -- Keeps the player's torso below the NPC torso.
        -- Increase Height to move farther downward.
        local targetPosition = targetRoot.Position - Vector3.new(
            0,
            math.max(0, Settings.Height),
            0
        )

        RootPart.CFrame = CFrame.new(targetPosition, targetRoot.Position)

        if Humanoid then
            Humanoid.PlatformStand = true
        end
    end
end)

-- Auto Fight
task.spawn(function()
    while ScreenGui.Parent do
        if Settings.AutoFight then
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            task.wait(Settings.FightInterval)
        else
            task.wait(0.1)
        end
    end
end)

-- Num 1 toggles Auto Fight
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if input.KeyCode == Enum.KeyCode.KeypadOne then
        Settings.AutoFight = not Settings.AutoFight
        updateButton(AutoFightButton, "Auto Fight", Settings.AutoFight)
    end
end)

-- Retarget immediately after an NPC dies.
workspace.DescendantRemoving:Connect(function(instance)
    if currentTarget and instance == currentTarget.Model then
        currentTarget = nil
    end
end)
