-- Dragging
local dragging = false
local dragStart
local startPosition

Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPosition = Main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

-- Toggle visual state
local function updateButton(button, label, enabled)
    button.Text = label .. ": " .. (enabled and "ON" or "OFF")
    if enabled then
        button.BackgroundColor3 = Color3.fromRGB(45, 20, 65)
    else
        button.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    end
end

AutoPerkButton.MouseButton1Click:Connect(function()
    Settings.AutoPerk = not Settings.AutoPerk
    updateButton(AutoPerkButton, "Auto Perk", Settings.AutoPerk)
end)

UnderFlyButton.MouseButton1Click:Connect(function()
    Settings.UnderFly = not Settings.UnderFly
    updateButton(UnderFlyButton, "Under Fly", Settings.UnderFly)

    if not Settings.UnderFly and Humanoid then
        Humanoid.PlatformStand = false
    end
end)

AutoFightButton.MouseButton1Click:Connect(function()
